# Copiá este archivo como .env.local y completá los valores.

# Secreto para firmar la cookie de sesión. Generalo con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Credenciales del OAuth Client ID de Google Cloud (tipo "Aplicación web").
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Opcional: dominio de mail que puede entrar (por defecto udesa.edu.ar).
# Usá "*" para permitir cualquier cuenta de Google mientras probás.
# AUTH_DOMINIO_PERMITIDO=udesa.edu.ar
